{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "description": "RestoPilote — gestion de restaurant (web, en ligne et application desktop)",
  "author": "RestoPilote",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "db:push": "drizzle-kit push --config=src/db/drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config=src/db/drizzle.config.ts",
    "desktop": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "mg.restopilote.desktop",
    "productName": "RestoPilote",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!release/**",
      "!**/*.map",
      "!src/**",
      "!image/**",
      "!*.md",
      "!note",
      "!.env*",
      "!mot-de-passe",
      "!fichier exe application/**",
      "!licence-privee/**",
      "!scripts/**",
      "!build/**",
      "!assets/**",
      "!chefsuite",
      "!tutoriel.docx",
      "!metadata.json",
      "!render.yaml"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "RestoPilote"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/pg": "^8.20.0",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.10",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
